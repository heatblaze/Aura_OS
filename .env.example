# ============================================================
# JARVIS AI OS — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# App
DEBUG=true

# Ollama (Free Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini        # Recommended for 12GB RAM: phi3:mini or llama3.2:3b
# OLLAMA_MODEL=mistral         # Better quality but ~4.5GB RAM
# OLLAMA_MODEL=llama3.2:3b    # Meta's latest small model ~2GB RAM

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://jarvis:jarvis_pass@localhost:5432/jarvis_db

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Security
SECRET_KEY=your-super-secret-key-change-this

# ---- OPTIONAL: Phase 2 API Integrations ----

# Google Calendar & Gmail
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Twilio (Calls & SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Web Search (falls back to free DuckDuckGo if not set)
# SERPAPI_KEY=
